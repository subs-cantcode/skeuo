[Template]
# Skeuo Video environment reference
#
# Milestone 1 (this app) is a frontend-only build and needs no variables.
# Copy this file to .env only when working on later milestones; .env is ignored
# by git and must never be committed.

# --- Milestone 2: accounts, database -------------------------------------
# DATABASE_URL="postgresql://skeuo:change-me@localhost:5432/skeuo_video"
# SESSION_SECRET="generate-with-openssl-rand-hex-32"

# --- Milestone 3: uploads and processing ---------------------------------
# UPLOAD_DIR="./uploads"                 # local development storage
# MAX_UPLOAD_BYTES="209715200"
# FFMPEG_PATH="ffmpeg"
# S3_ENDPOINT=""                         # any S3-compatible object store
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
